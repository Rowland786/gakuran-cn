    "juZtli72": {
      "refs": {
        "6aaefa34458fd28255321602": {
          "heading": "玩家指令",
          "after": "“PLAYERS（玩家）”标签页用于对玩家执行操作，第一项可封禁玩家并指定期限。",
          "label": "封禁玩家"
        },
        "6af1ecf78b998f8f7489259f": {
          "heading": "玩家指令",
          "after": "Shift＋点击可多选玩家，再统一授予角色、拉到身边、重生、解冻、治疗或执行其他操作。",
          "label": "批量操作"
        },
        "6aaefa3b8f99d82e05287e54": {
          "heading": "玩家指令",
          "after": "标签页顶部可搜索并滚动查看当前服务器的在线成员。",
          "label": "玩家列表"
        },
        "6aaefa41460a2a99d1c2f53e": {
          "heading": "玩家指令",
          "after": "也能解除已封禁玩家的封禁。",
          "label": "解除封禁"
        },
        "6aaefa4d6720f8fbbde702f7": {
          "heading": "玩家指令",
          "after": "也能解除已封禁玩家的封禁。",
          "label": "封禁记录"
        },
        "6aaefa53303c7dc9acaf4431": {
          "heading": "NPC 指令",
          "after": "1. 生成一名基础 NPC，坐到距离自己最近的座位。",
          "label": "单个NPC"
        },
        "6aaefa9adda18707fa0717b3": {
          "heading": "NPC 指令",
          "after": "2. 生成1—50名 NPC，分别坐到离自己最近的空座。",
          "label": "座位NPC"
        },
        "6aaefbee5cea27da300ca2f5": {
          "heading": "NPC 指令",
          "after": "3. 在面前生成1—120名 NPC，组成一群人。",
          "label": "NPC群体"
        },
        "6aaefbf429277bdafaebfcc9": {
          "heading": "NPC 指令",
          "after": "4. 生成演奏 NPC，与你一起表演。鼓手和键盘手需要空闲乐器，其他演奏者会自带乐器。",
          "label": "演奏NPC"
        },
        "6aaefbfa6c10d88e85403b7a": {
          "heading": "NPC 指令",
          "after": "5. 生成友军小队，在身后跟随，也会一起战斗。可用“/s follow”命令跟随，用“/s attack”命令攻击，并可指定他们的服装。",
          "label": "友军小队"
        },
        "6aaefc0222366042b824ba5d": {
          "heading": "NPC 指令",
          "after": "6. 移除身边最近的 NPC，也可输入名字移除指定 NPC。",
          "label": "移除NPC"
        }
      }
    },
